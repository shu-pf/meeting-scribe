# コピーして .env として保存し、値を埋めてください。
# cp .env.example .env

NOTARY_APPLE_ID=your@email.com
NOTARY_TEAM_ID=XXXXXXXXXX
NOTARY_PASSWORD=xxxx-xxxx-xxxx-xxxx
NOTARY_IDENTITY="Developer ID Application: Your Name (XXXXXXXXXX)"

# 推奨: パスワードを平文で置かず、キーチェーンに保存した認証情報を使う。
#   xcrun notarytool store-credentials meeting-scribe --apple-id your@email.com --team-id XXXXXXXXXX
# を一度実行してアプリ用パスワードを入力し、次の行を有効にすると上の3項目は不要。
# NOTARY_KEYCHAIN_PROFILE=meeting-scribe

# リリース時: 版番号だけ（notarize が plist と appcast URL に反映）
# APP_VERSION=1.2.0

# 任意: 出力先 / Sparkle ツールの場所
# DIST_DIR=/absolute/path/to/output
# SPARKLE_BIN_DIR=/path/to/Sparkle/bin
